// wsx dev container. The image is pinned by exact tag in the Dockerfile next to
// this file, not here: Dependabot's `devcontainers` ecosystem only updates
// Features and never `image`, so a pin in this file would never get an update
// PR. Its `docker` ecosystem does update a Dockerfile FROM line.
// rust-toolchain.toml supplies the exact rustc and its components.
// Keep this file free of Features: any Feature added becomes a Dependabot
// `devcontainers` update target.
{
  "name": "wsx",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "mounts": [
    {
      "source": "wsx-cargo-registry",
      "target": "/usr/local/cargo/registry",
      "type": "volume"
    },
    {
      "source": "wsx-cargo-git",
      "target": "/usr/local/cargo/git",
      "type": "volume"
    },
    {
      "source": "wsx-target-${localWorkspaceFolderBasename}",
      "target": "${containerWorkspaceFolder}/target",
      "type": "volume"
    }
  ],
  // Docker creates fresh named volumes as root; claim writable Cargo volumes for the lifecycle user.
  "postCreateCommand": "sudo chown -R \"$(id -u):$(id -g)\" /usr/local/cargo/registry /usr/local/cargo/git \"${containerWorkspaceFolder}/target\" && git config --global --add safe.directory \"${containerWorkspaceFolder}\"",
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "vadimcn.vscode-lldb"
      ]
    }
  },
  "remoteUser": "vscode"
}
